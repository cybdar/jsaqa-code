{
  "name": "cypress-tests",
  "version": "1.0.0",
  "description": "E2E tests for booksApp with Cypress",
  "main": "index.js",
  "scripts": {
    "cy:open:desktop": "cypress open --e2e --browser chrome",
    "cy:run:desktop": "cypress run --e2e --browser chrome",
    "cy:open:mobile": "cypress open --e2e --browser chrome --config-file cypress.mobile.config.js",
    "cy:run:mobile": "cypress run --e2e --browser chrome --config-file cypress.mobile.config.js"
  },
  "keywords": ["cypress", "e2e", "testing"],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "cypress": "^13.15.0"
  }
}